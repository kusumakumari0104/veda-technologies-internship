import java.util.Scanner;

public class MultiplicationTableGenerator {

    // Method to generate multiplication table
    public static void generateTable(int number) {
        System.out.println("\nMultiplication Table of " + number);
        System.out.println("-----------------------------");

        for (int i = 1; i <= 10; i++) {
            System.out.println(number + " x " + i + " = " + (number * i));
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("=== Multiplication Table Generator ===");
        System.out.println("1. Generate table for a single number");
        System.out.println("2. Generate tables for a range of numbers");

        System.out.print("Enter your choice: ");
        int choice = sc.nextInt();

        switch (choice) {

            case 1:
                System.out.print("Enter a number: ");
                int number = sc.nextInt();

                generateTable(number);
                break;

            case 2:
                System.out.print("Enter starting number: ");
                int start = sc.nextInt();

                System.out.print("Enter ending number: ");
                int end = sc.nextInt();

                System.out.println("\n=== Multiplication Tables ===");

                // Nested loops for multiple tables
                for (int num = start; num <= end; num++) {
                    generateTable(num);
                }
                break;

            default:
                System.out.println("Invalid choice!");
        }

        sc.close();
    }
}
