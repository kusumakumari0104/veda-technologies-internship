
import java.util.HashSet;
import java.util.Scanner;
import java.util.Set;

public class EmailRegistry {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Set<String> emails = new HashSet<>();

        int choice;

        do {
            System.out.println("\n===== EMAIL REGISTRY SYSTEM =====");
            System.out.println("1. Register Email");
            System.out.println("2. Remove Email");
            System.out.println("3. Display All Emails");
            System.out.println("4. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    System.out.print("Enter email address: ");
                    String email = sc.nextLine().trim().toLowerCase();

                    if (email.isEmpty() || !email.matches(
                            "^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$")) {
                        System.out.println("Invalid email address!");
                    } else if (emails.add(email)) {
                        System.out.println("Email registered successfully!");
                    } else {
                        System.out.println("Duplicate email! Registration failed.");
                    }
                    break;

                case 2:
                    System.out.print("Enter email to remove: ");
                    String removeEmail = sc.nextLine().trim().toLowerCase();

                    if (emails.remove(removeEmail)) {
                        System.out.println("Email removed successfully!");
                    } else {
                        System.out.println("Email not found!");
                    }
                    break;

                case 3:
                    if (emails.isEmpty()) {
                        System.out.println("No emails registered.");
                    } else {
                        System.out.println("\nRegistered Email Addresses:");
                        for (String e : emails) {
                            System.out.println(e);
                        }
                        System.out.println("Total emails: " + emails.size());
                    }
                    break;

                case 4:
                    System.out.println("Exiting Email Registry System...");
                    break;

                default:
                    System.out.println("Invalid choice! Please try again.");
            }
        } while (choice != 4);

        sc.close();
    }
}
