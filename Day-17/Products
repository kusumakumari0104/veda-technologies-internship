import java.util.ArrayList;
import java.util.Scanner;

class Product {
    private int id;
    private String name;
    private double price;
    private int quantity;

    public Product(int id, String name, double price, int quantity) {
        this.id = id;
        this.name = name;
        this.price = price;
        this.quantity = quantity;
    }

    public int getId() {
        return id;
    }

    public void update(String name, double price, int quantity) {
        this.name = name;
        this.price = price;
        this.quantity = quantity;
    }

    public void display() {
        System.out.printf("%-10d %-20s %-12.2f %-10d%n",
                id, name, price, quantity);
    }
}

public class InventorySystem {
    static ArrayList<Product> products = new ArrayList<>();
    static Scanner sc = new Scanner(System.in);

    // Search product by ID
    static Product searchProduct(int id) {
        for (Product p : products) {
            if (p.getId() == id) {
                return p;
            }
        }
        return null;
    }

    // Add product
    static void addProduct() {
        System.out.print("Enter Product ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        if (searchProduct(id) != null) {
            System.out.println("Product ID already exists!");
            return;
        }

        System.out.print("Enter Product Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Price: ");
        double price = sc.nextDouble();

        System.out.print("Enter Quantity: ");
        int quantity = sc.nextInt();

        if (price < 0 || quantity < 0) {
            System.out.println("Price and quantity cannot be negative.");
            return;
        }

        products.add(new Product(id, name, price, quantity));
        System.out.println("Product added successfully!");
    }

    // Display all products
    static void displayProducts() {
        if (products.isEmpty()) {
            System.out.println("Inventory is empty.");
            return;
        }

        System.out.printf("%-10s %-20s %-12s %-10s%n",
                "ID", "Name", "Price", "Quantity");

        for (Product p : products) {
            p.display();
        }
    }

    // Search product
    static void search() {
        System.out.print("Enter Product ID to search: ");
        int id = sc.nextInt();

        Product p = searchProduct(id);

        if (p != null) {
            System.out.printf("%-10s %-20s %-12s %-10s%n",
                    "ID", "Name", "Price", "Quantity");
            p.display();
        } else {
            System.out.println("Product not found.");
        }
    }

    // Update product
    static void updateProduct() {
        System.out.print("Enter Product ID to update: ");
        int id = sc.nextInt();
        sc.nextLine();

        Product p = searchProduct(id);

        if (p == null) {
            System.out.println("Product not found.");
            return;
        }

        System.out.print("Enter New Product Name: ");
        String name = sc.nextLine();

        System.out.print("Enter New Price: ");
        double price = sc.nextDouble();

        System.out.print("Enter New Quantity: ");
        int quantity = sc.nextInt();

        if (price < 0 || quantity < 0) {
            System.out.println("Price and quantity cannot be negative.");
            return;
        }

        p.update(name, price, quantity);
        System.out.println("Product updated successfully!");
    }

    // Remove product
    static void removeProduct() {
        System.out.print("Enter Product ID to remove: ");
        int id = sc.nextInt();

        Product p = searchProduct(id);

        if (p != null) {
            products.remove(p);
            System.out.println("Product removed successfully!");
        } else {
            System.out.println("Product not found.");
        }
    }

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n===== INVENTORY MANAGEMENT SYSTEM =====");
            System.out.println("1. Add Product");
            System.out.println("2. Display Products");
            System.out.println("3. Search Product");
            System.out.println("4. Update Product");
            System.out.println("5. Remove Product");
            System.out.println("6. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    addProduct();
                    break;
                case 2:
                    displayProducts();
                    break;
                case 3:
                    search();
                    break;
                case 4:
                    updateProduct();
                    break;
                case 5:
                    removeProduct();
                    break;
                case 6:
                    System.out.println("Exiting Inventory System...");
                    break;
                default:
                    System.out.println("Invalid choice! Try again.");
            }
        } while (choice != 6);

        sc.close();
    }
}
